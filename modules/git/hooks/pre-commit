#  --input "$DETEKT_INPUT" \
#  --build-upon-default-config \
#  --config "$DETEKT/formatting-config.yaml" \
#  --baseline "$DETEKT"/baseline.xml \
#  --create-baseline \
#  --plugins "$DETEKT/plugins/detekt-formatting-1.23.7.jar" 2>&1

## リント実行
